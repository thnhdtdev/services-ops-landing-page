# Set the production URL to enable indexing and canonical metadata.
NEXT_PUBLIC_SITE_URL=

# Zalo link for "Nhắn Zalo", e.g. https://zalo.me/0xxxxxxxxx
# Empty: the button stays visible and says the number is being updated.
NEXT_PUBLIC_ZALO_URL=

# Optional trial sign-up link (Google Form, etc.) for "Đăng ký dùng thử".
# Empty: the button falls back to Zalo, or says the link is being updated.
NEXT_PUBLIC_TRIAL_URL=
